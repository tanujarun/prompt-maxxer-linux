{
  "name": "prompt-maxxer-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "engine": "${XDG_DATA_HOME:-$HOME/.local/share}/prompt-maxxer/venv/bin/python -m prompt_maxxer",
    "engine:devices": "${XDG_DATA_HOME:-$HOME/.local/share}/prompt-maxxer/venv/bin/python -m prompt_maxxer --list-devices"
  },
  "dependencies": {
    "@fontsource/doto": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@10.34.6"
}
